# No VITE_COMMIT_SHA here, deliberately. The commit is resolved from git by
# vite.config.ts and injected as __COMMIT_SHA__. A SHA written into this file
# is a SHA nobody updates: the previous one sat at 6ac1909c from 2026-08-13
# through every release after it.
VITE_APP_VERSION=designproai-os-migration
# Exposes the opt-in diagnostic selector. Legacy remains the selected/default
# request path, so rollback is one variable change plus a rebuild.
VITE_DESIGNPRO_FLAT_FIRST_V1=on
