# Build-time target for the migrated DesignProAI application.
#
# The code move and the data move are separate migrations, and this file is
# where that separation is visible. The application reads 187 distinct tables;
# the isolated DesignProAI project (wozyamlnygaddievzuwn) currently has 12, all
# designpro_*. Pointing the build there today would deploy a site where every
# page fails on a missing relation, so the app is migrated as-is and keeps
# talking to the database it already works against.
#
# Both values are publishable by design — a publishable key is shipped inside
# the browser bundle no matter where it is stored, and carries no privilege
# beyond row-level security. No secret key belongs in this file, ever.
#
# Moving the data is the next migration. When the DesignProAI project holds the
# schema this app needs, these two lines are the whole cutover.
VITE_SUPABASE_URL=https://kfapjdyythzyvnpdeghu.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_vZPN0KK9Kcbqg6YlbTPv0Q_Z65N7Om_
