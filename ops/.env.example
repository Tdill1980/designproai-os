# This file is intentionally not consumed by Docker Compose.
# Copy the two role-specific templates instead:
#
#   runtime.env.example -> /opt/designproai/shared/runtime.env
#   gateway.env.example -> /opt/designproai/shared/gateway.env
#
# Keep both files owned by root with mode 0600. Never put a Supabase secret
# key in gateway.env or a browser/public key in runtime.env.
