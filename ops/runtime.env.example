# Root-owned server secret file: /opt/designproai-os/shared/runtime.env (mode 0600)
SUPABASE_URL=https://wozyamlnygaddievzuwn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_designproai_project_secret_key
WORKER_SECRET=replace_with_at_least_32_random_characters
GOOGLE_AI_API_KEY=replace_with_designproai_google_ai_key
# The locked render model. Upstream reverted the GA id back to the -preview
# alias (PR #3381) to remove project-enablement risk of a hard render error;
# they are the same model. Do not set DESIGNPRO_IMAGE_MODELS to add a fallback.
GOOGLE_IMAGE_MODEL=gemini-3-pro-image-preview
DESIGNPRO_APP_ORIGIN=https://os.designproai.com
DESIGNPRO_SPOOL_DIR=/var/lib/designproai/spool
SUPABASE_TUS_ENDPOINT=https://wozyamlnygaddievzuwn.storage.supabase.co/storage/v1/upload/resumable
DESIGNPRO_OUTBOUND_EMAIL_ENABLED=false
DESIGNPRO_TOPAZ_ENABLED=false
TOPAZ_API_KEY=
TOPAZ_MODEL=High Fidelity V2
