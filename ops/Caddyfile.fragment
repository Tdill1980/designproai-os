# The apex is the selling site. It serves the public routes from the exact same
# immutable web artifact as the OS, but it exposes no gateway or worker path.
designproai.com {
  encode zstd gzip

  handle {
    root * /opt/designproai-os/public/web/dist
    try_files {path} /index.html
    file_server
  }

  header {
    -Server
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
  }

  log {
    output file /var/log/caddy/designpro-apex-access.log {
      roll_size 25MiB
      roll_keep 10
      roll_keep_for 336h
    }
  }
}

# Keep one canonical marketing origin. The www host never crosses into the OS.
www.designproai.com {
  redir https://designproai.com{uri} 301

  log {
    output file /var/log/caddy/designpro-www-access.log {
      roll_size 25MiB
      roll_keep 10
      roll_keep_for 336h
    }
  }
}

os.designproai.com {
  encode zstd gzip

  # The browser is a control panel. It never calls a production worker.
  # Keeping this explicit prevents the SPA fallback from making a worker path
  # appear to exist if a stale client tries to use one.
  handle /worker/* {
    respond 404
  }

  # Server-to-server only: the migrated DesignPro edge functions call the
  # proven worker's compositor endpoints (/compose-proof-sheet,
  # /call7-sanity-check, /clean-artboard, /passenger-mirror, /panel-qccheck,
  # /lift-overlays, ...) with the shared worker secret. The worker rejects
  # every unauthenticated request itself; browsers still have no worker path.
  handle_path /designpro-worker/* {
    reverse_proxy 127.0.0.1:3005
  }

  handle /api/* {
    reverse_proxy 127.0.0.1:8787
  }

  handle /gateway-healthz {
    rewrite * /healthz
    reverse_proxy 127.0.0.1:8787
  }

  handle {
    root * /opt/designproai-os/public/web/dist
    try_files {path} /index.html
    file_server
  }

  header {
    -Server
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
  }

  log {
    output file /var/log/caddy/designpro-access.log {
      roll_size 25MiB
      roll_keep 10
      roll_keep_for 336h
    }
  }
}
