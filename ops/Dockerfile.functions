# The DesignPro edge functions, served from the droplet instead of Supabase.
#
# These are the SAME files that ran as Supabase Edge Functions - plain Deno HTTP
# servers using serve() from deno.land/std, with URL imports and no
# platform-specific runtime. So they move to this host unchanged: no rewrite, no
# hand-port, no second implementation to keep in sync.
#
# That last point is the whole reason this exists. Re-deriving 470 functions as
# .cjs modules one at a time is how the standalone system ended up with a
# frontend calling functions that were never migrated, and a separate kernel
# behaving differently from the product it replaced.
FROM denoland/deno:2.1.4

ENV DENO_DIR=/deno-dir
WORKDIR /app

COPY supabase/functions ./functions
COPY ops/functions-server.ts ./functions-server.ts
COPY ops/designpro-functions.txt ./designpro-functions.txt

# Drop everything the DesignPro chain does not reach. The migration copied all
# of restylepro-os so nothing would be missing mid-port, but the image that runs
# on the droplet carries only the proven set plus the shared modules they import.
# The server refuses an unlisted name anyway; this keeps it off the disk too.
RUN set -eu; \
    grep -vE '^\s*(#|$)' designpro-functions.txt | tr -d '\r' | sort -u > /tmp/keep; \
    test -s /tmp/keep; \
    for dir in functions/*/; do \
      name=$(basename "$dir"); \
      case "$name" in _*) continue;; esac; \
      grep -qxF "$name" /tmp/keep || rm -rf "$dir"; \
    done; \
    while read -r name; do \
      test -f "functions/$name/index.ts" || { echo "allowlisted function missing: $name" >&2; exit 1; }; \
    done < /tmp/keep

# Warm the module cache at build time so a cold container does not fetch
# dependencies on its first request, and so a network blip at runtime cannot
# turn into a failed generation.
RUN deno cache --allow-import functions-server.ts || true

EXPOSE 3003
CMD ["deno", "run", "--allow-net", "--allow-env", "--allow-read", "--allow-import", "functions-server.ts"]
