FROM node:22.23.1-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3
ENV NODE_ENV=production
RUN groupadd --gid 10001 designpro && \
    useradd --uid 10001 --gid 10001 --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin designpro
WORKDIR /app
COPY gateway/package.json gateway/package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY gateway/src ./src
COPY ops/gateway-healthcheck.mjs ./healthcheck.mjs
RUN node --check src/server.mjs && node --check healthcheck.mjs
USER 10001:10001
EXPOSE 8787
CMD ["node", "src/server.mjs"]
