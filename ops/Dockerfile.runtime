FROM node:22.23.1-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3
ENV NODE_ENV=production
RUN groupadd --gid 10001 designpro && \
    useradd --uid 10001 --gid 10001 --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin designpro
# The 2D proof is typeset from a font FILE, never a family name: libvips
# resolves families through fontconfig and substitutes silently, which is how a
# proof ends up carrying letterforms the panels do not. opentype-outline.cjs
# reads TrueType tables out of exact bytes, so a real .ttf has to exist in the
# image. Calls 1-7 author imagery-only assets and pin no font of their own, so
# without this the proof stage fails closed as call8_proof_font_missing.
RUN apt-get update \
    && apt-get install -y --no-install-recommends fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY runtime/package.json runtime/package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY runtime/ ./
COPY ops/runtime-healthcheck.js ./healthcheck.js
RUN npm run check
USER 10001:10001
EXPOSE 3001
CMD ["node", "index.js"]
